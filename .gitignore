.DS_Store
**/.DS_Store
# .claude — Supervisor sources are tracked; only runtime/private artifacts ignored
.claude/logs/
.claude/**/*.log
.claude/**/debug-*
.claude/**/.env*
.claude/**/*.key
.claude/**/*.pem
.claude/**/*.secret.*
.claude/mcp-config*.json
# autonomous supervisor runtime state (only .gitkeep is tracked)
.claude/supervisor/state/*
!.claude/supervisor/state/.gitkeep
__MACOSX/
