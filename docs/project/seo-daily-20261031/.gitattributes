# Preserve byte-pinned CRLF receipts, including checkout bytes, without treating CR as trailing whitespace.
ai-planner-public-before.json -text whitespace=blank-at-eol,blank-at-eof,space-before-tab,cr-at-eol
ai-planner-public-after.json -text whitespace=blank-at-eol,blank-at-eof,space-before-tab,cr-at-eol
