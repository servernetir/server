[Unit]
Description=ServerNet scoped Proxmox web console gateway
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=sn-console
Group=sn-console
ExecStart=/usr/bin/python3 /opt/servernet-console/gateway.py
Restart=on-failure
RestartSec=3
NoNewPrivileges=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectSystem=strict
ProtectHome=yes
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
UMask=0077
StateDirectory=servernet-console
StateDirectoryMode=0700
MemoryMax=256M
TasksMax=32

[Install]
WantedBy=multi-user.target
