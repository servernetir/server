# =============================================================================
#  /etc/servernet/pf-agent.env — پیکربندیِ مشترکِ هر دو عاملِ هاستِ ایران.
#  این فایل را Ansible مالک است؛ دستی ویرایشش نکنید (تغییرِ دستی با اجرای
#  بعدیِ نقش بازنویسی می‌شود).
#
#  ⚠️ چرا این فایل مهم است: هر دو عامل — port-forward و country-routing —
#  آدرس و توکن را از همین‌جا می‌خوانند. اگر کهنه شود، عامل‌ها بی‌صدا ۴۰۳/۳۰۱
#  می‌گیرند و هیچ مسیر یا پورتی اعمال نمی‌شود، بدون هیچ خطای آشکاری.
#  (حادثهٔ ۲۰۲۶-۰۸-۲۱: این فایل روی پنلِ interimِ قدیمی 10.10.10.30 و توکنِ
#  قبلی مانده بود ⇒ ضربانِ صفحهٔ «زیرساختِ اکسیت» ۵۰۵۳ دقیقه کهنه شد.)
# =============================================================================

# مسیرِ port-forward روی پنلِ اصلی
PF_API={{ pf_panel_url }}

# مسیرِ country-routing (سرویسِ servernet-country-agent از همین‌جا می‌خوانَد)
CR_API={{ cr_panel_url }}

# توکنِ مشترکِ هر دو عامل — با agent_pull_token در تنظیماتِ پنل یکی است.
PF_AGENT_TOKEN={{ vault_pf_agent_token }}

# اینترفیسِ عمومی که DNAT رویش بسته می‌شود
PF_WANIF={{ pf_public_iface }}
