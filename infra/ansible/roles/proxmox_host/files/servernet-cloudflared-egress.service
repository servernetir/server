[Unit]
Description=Scoped Cloudflare Tunnel egress through the existing Germany relay
Wants=network-online.target
After=network-online.target pve-guests.service
StartLimitIntervalSec=0

[Service]
Type=oneshot
ExecStart=/usr/local/sbin/servernet-cloudflared-egress
TimeoutStartSec=90
Restart=on-failure
RestartSec=5

[Install]
WantedBy=multi-user.target
