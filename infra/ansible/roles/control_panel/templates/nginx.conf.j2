# ServerNet control panel — nginx site (rendered by Ansible).
# audit SSL: serve HTTPS (was HTTP-only, which caused the SSL error on
# https://panel.servernet.cloud). HTTP redirects to HTTPS (ACME path excepted).
# The cert defaults to a self-signed pair (generated by the role if missing); set
# panel_tls_cert/panel_tls_key to a real (Let's Encrypt / Cloudflare Origin) cert
# for a trusted, warning-free certificate.

server {
    listen 80;
    server_name panel.servernet.cloud {{ control_ip }};

    # keep ACME http-01 working if you later use Let's Encrypt on port 80
    location ^~ /.well-known/acme-challenge/ { root /var/www/html; allow all; }

    location / { return 301 https://$host$request_uri; }
}

server {
    listen 443 ssl;
    http2 on;
    server_name panel.servernet.cloud {{ control_ip }};

    ssl_certificate     {{ panel_tls_cert }};
    ssl_certificate_key {{ panel_tls_key }};
    ssl_protocols       TLSv1.2 TLSv1.3;
    ssl_ciphers         HIGH:!aNULL:!MD5;
    ssl_prefer_server_ciphers on;

    root {{ panel_app_dir }}/public;
    index index.php;
    charset utf-8;

    location / {
        try_files $uri $uri/ /index.php?$query_string;
    }

    location = /favicon.ico { access_log off; log_not_found off; }
    location = /robots.txt  { access_log off; log_not_found off; }

    error_page 404 /index.php;

    location ~ \.php$ {
        fastcgi_pass unix:{{ php_fpm_sock }};
        fastcgi_param SCRIPT_FILENAME $realpath_root$fastcgi_script_name;
        fastcgi_param HTTPS on;
        include fastcgi_params;
    }

    location ~ /\.(?!well-known).* {
        deny all;
    }
}
