# Rendered by Ansible — ServerNet control panel environment.
# config/proxmox.php and config/cloudflare.php read these via env().
APP_NAME=ServerNet
APP_ENV=production
APP_KEY={{ vault_panel_app_key }}
APP_DEBUG=false
APP_URL={{ panel_app_url }}
LOG_CHANNEL=stack
LOG_LEVEL=warning

DB_CONNECTION=sqlite
DB_DATABASE={{ panel_app_dir }}/database/database.sqlite
DB_FOREIGN_KEYS=true

SESSION_DRIVER=file
CACHE_STORE=file
QUEUE_CONNECTION=sync

# --- Proxmox (least-privilege token, NEVER root) -----------------------------
PVE_HOST={{ pve_api_host }}
PVE_PORT={{ pve_api_port }}
PVE_NODE={{ pve_node }}
PVE_TOKEN_ID={{ pve_svc_user }}!{{ pve_svc_token_id }}
PVE_TOKEN_SECRET={{ vault_pve_token_secret }}
PVE_VERIFY_TLS=false
PVE_VM_STORAGE={{ vm_storage }}
PVE_POOL={{ pve_customer_pool }}
PVE_PROTECTED_VMIDS={{ protected_vmids | join(',') }}
PVE_CUSTOMER_VMID_MIN={{ customer_vmid_min }}

# --- Sale ranges -------------------------------------------------------------
SALE_PORT_MIN={{ sale_port_min }}
SALE_PORT_MAX={{ sale_port_max }}
PUBLIC_IP={{ public_ip }}
CUSTOMER_IP_START={{ customer_ip_start }}

# --- Cloudflare (optional; wildcard already resolves everything) -------------
CF_API_TOKEN={{ vault_cf_api_token }}
CF_ACCOUNT_ID={{ vault_cf_account_id }}
CF_ZONE_NAME=servernet.cloud
CF_PUBLIC_IP={{ public_ip }}
CF_PROXIED=false
CF_ENABLED=true

# --- Panel auth + agent ------------------------------------------------------
PANEL_ADMIN_USER={{ vault_panel_admin_user }}
PANEL_ADMIN_PASSWORD={{ vault_panel_admin_password }}
AGENT_TOKEN={{ vault_pf_agent_token }}
