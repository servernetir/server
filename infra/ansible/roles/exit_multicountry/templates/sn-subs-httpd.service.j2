[Unit]
Description=ServerNet subscription server (sanitized per-country lists)
After=network.target

[Service]
Type=simple
ExecStart=/usr/bin/python3 -m http.server {{ subs_httpd_port }} --bind 127.0.0.1 --directory {{ subs_dir }}
Restart=on-failure
RestartSec=3

[Install]
WantedBy=multi-user.target
