#!/usr/bin/env bash
# servernet-vm-country-del <vm-ip>  — runs on the Proxmox HOST.
# Removes the connmark split for this VM (host mangle marks + fwmark rule +
# forward accept) and the in-{{ cr_ctid }} country-tun routing. Idempotent.
set -uo pipefail
CT={{ cr_ctid }}; LANIF={{ cr_lan_if }}; T={{ cr_split_table }}; M={{ cr_split_mark }}; MASK={{ cr_split_mask }}
V="${1:?usage: servernet-vm-country-del <vm-ip>}"

iptables -t mangle -D PREROUTING -i "$LANIF" -s "$V" -j CONNMARK --restore-mark 2>/dev/null || true
iptables -t mangle -D PREROUTING -i "$LANIF" -s "$V" -m conntrack --ctstate NEW -m mark --mark 0x0/$MASK -j MARK --set-xmark $M/$MASK 2>/dev/null || true
iptables -t mangle -D PREROUTING -i "$LANIF" -s "$V" -j CONNMARK --save-mark 2>/dev/null || true
while ip rule del from "$V" fwmark $M/$MASK lookup $T 2>/dev/null; do :; done
iptables -D FORWARD -s "$V" -i "$LANIF" -o "$LANIF" -j ACCEPT 2>/dev/null || true

pct exec "$CT" -- /usr/local/bin/servernet-vm-country-del "$V" 2>/dev/null || true
echo "unrouted $V"
