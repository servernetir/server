[Unit]
Description=ServerNet per-country tun (%i)
After=mihomo.service network-online.target
Wants=mihomo.service

[Service]
EnvironmentFile=/etc/servernet/country-%i.env
# ExecStart is a wrapper so UPSTREAM (free pool vs dedicated exit) is honored;
# systemd can't do ${UPSTREAM:-default} expansion, the wrapper does.
ExecStart=/usr/local/bin/servernet-country-run %i
ExecStartPost=/usr/local/bin/servernet-country-up %i
Restart=always
RestartSec=3

[Install]
WantedBy=multi-user.target
