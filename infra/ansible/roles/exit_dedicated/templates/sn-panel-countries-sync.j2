#!/usr/bin/env bash
# sn-panel-countries-sync <list>  — runs INSIDE the panel container ({{ ded_panel_ctid }}).
# Regenerates {{ ded_panel_app_dir }}/config/countries_dedicated.php from a
# cc|method|label|detail list, then clears the config cache. countries.php merges
# this overlay, so dedicated countries appear in the sale-time dropdown.
set -uo pipefail
LIST="${1:?usage: sn-panel-countries-sync <list-file>}"
APP={{ ded_panel_app_dir }}
OUT="$APP/config/countries_dedicated.php"

tmp="$(mktemp)"
{
  echo '<?php'
  echo '// AUTO-GENERATED by servernet-exit-set — do not edit by hand.'
  echo '// Dedicated (guaranteed) exit countries; merged by config/countries.php.'
  echo 'return ['
  while IFS='|' read -r cc method label detail; do
    [ -n "${cc:-}" ] || continue
    ccu="$(printf '%s' "$cc" | tr '[:lower:]' '[:upper:]')"
    lbl="$(printf '%s' "${label:-$cc}" | sed "s/'/\\\\'/g")"
    printf "    '%s' => ['label' => '%s', 'flag' => '%s', 'tier' => 'dedicated'],\n" "$cc" "$lbl" "$ccu"
  done < "$LIST"
  echo '];'
} > "$tmp"
mv "$tmp" "$OUT"
cd "$APP" && php artisan config:clear >/dev/null 2>&1 || true
echo "wrote $OUT"
