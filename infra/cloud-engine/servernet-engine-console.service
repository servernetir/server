[Unit]
Description=ServerNet Cloud Engine console gateway
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=servernet-engine
Group=servernet-engine
EnvironmentFile=/etc/servernet-engine/console.env
ExecStart=/opt/servernet-engine/venv/bin/python /opt/servernet-engine/console_gateway.py
Restart=on-failure
RestartSec=5
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
UMask=0077

[Install]
WantedBy=multi-user.target
