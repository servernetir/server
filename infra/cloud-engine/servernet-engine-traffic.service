[Unit]
Description=ServerNet Cloud Engine host tap traffic collector
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=servernet-engine
Group=servernet-engine
ExecStart=/usr/bin/python3 /opt/servernet-engine/traffic_collector.py --config /etc/servernet-engine/traffic.json
Restart=on-failure
RestartSec=10
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/servernet-engine
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
UMask=0077

[Install]
WantedBy=multi-user.target
