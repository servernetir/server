# Securely provide the SAME random secret as Laravel ENGINE_CONSOLE_GATEWAY_SECRET.
# Values below are intentionally not deployable credentials or live destinations.
ENGINE_CONSOLE_GATEWAY_SECRET=
ENGINE_CONSOLE_BACKCHANNEL_URL=https://console.example.invalid/api/v1/cloud-engine/internal/console
ENGINE_CONSOLE_ALLOWED_ORIGINS=https://vnc.example.invalid
# Exact host:port, including default443 if configured explicitly in the node URL.
ENGINE_CONSOLE_PVE_HOSTS=pve.example.invalid:8006
ENGINE_NOVNC_DIR=/opt/servernet-engine/novnc
ENGINE_CONSOLE_BIND=127.0.0.1
ENGINE_CONSOLE_PORT=8443
ENGINE_CONSOLE_MAX_CONNECTIONS=64
ENGINE_CONSOLE_TLS_CERT=/etc/servernet-engine/tls/fullchain.pem
ENGINE_CONSOLE_TLS_KEY=/etc/servernet-engine/tls/privkey.pem
ENGINE_CONSOLE_CA_DIRECTORY=/etc/servernet-engine/ca
