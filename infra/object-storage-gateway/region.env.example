# One copy per region: /etc/servernet-object-gateway/{fsn1,nbg1,hel1}.env
VGW_PORT=9211
VGW_IAM_DIR=/var/lib/servernet-object-gateway/iam-fsn1
ROOT_ACCESS_KEY_ID=replace-with-local-versity-root-access
ROOT_SECRET_ACCESS_KEY=replace-with-local-versity-root-secret
VGW_S3_ACCESS_KEY=replace-with-hetzner-project-access-key
VGW_S3_SECRET_KEY=replace-with-hetzner-project-secret-key
VGW_S3_ENDPOINT=https://fsn1.your-objectstorage.com
VGW_S3_REGION=fsn1
VGW_S3_META_BUCKET=replace-with-private-meta-bucket
VGW_S3_USE_PATH_STYLE=true
