[Unit]
Description=ServerNet Object Storage control API
After=network-online.target servernet-object@fsn1.service servernet-object@nbg1.service servernet-object@hel1.service
Wants=network-online.target

[Service]
Type=simple
User=servernet-object
Group=servernet-object
EnvironmentFile=/etc/servernet-object-gateway/control.env
WorkingDirectory=/opt/servernet-object-gateway
ExecStart=/opt/servernet-object-gateway/venv/bin/python /opt/servernet-object-gateway/gateway.py
Restart=on-failure
RestartSec=3
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/servernet-object-gateway

[Install]
WantedBy=multi-user.target
