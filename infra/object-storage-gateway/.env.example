SN_OBJECT_DB=/var/lib/servernet-object-gateway/tenants.sqlite3
SN_OBJECT_HMAC_SECRET=replace-with-at-least-32-random-characters
SN_OBJECT_CREDENTIAL_SEED=replace-with-a-different-32-character-random-secret
SN_OBJECT_API_BIND=127.0.0.1
SN_OBJECT_API_PORT=9180
# JSON keys: fsn1, nbg1, hel1. Each value contains local_endpoint,
# public_endpoint, root_access and root_secret. Keep this file mode 0600.
SN_OBJECT_REGIONS_JSON={}
