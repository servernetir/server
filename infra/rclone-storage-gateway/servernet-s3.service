[Unit]
Description=ServerNet managed backup S3-compatible beta gateway
After=network-online.target servernet-gateway.service

[Service]
Type=simple
User=servernet-gateway
Group=servernet-gateway
WorkingDirectory=/opt/servernet-gateway
EnvironmentFile=/etc/servernet-gateway.env
ExecStart=/usr/bin/rclone serve s3 --addr 127.0.0.1:9082 --auth-proxy /opt/servernet-gateway/auth_proxy.py --vfs-cache-mode off --dir-cache-time 1m --force-path-style
Restart=always
RestartSec=3
MemoryMax=512M
CPUQuota=60%
TasksMax=128
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ReadWritePaths=/var/lib/servernet-gateway /var/cache/servernet-gateway

[Install]
WantedBy=multi-user.target
