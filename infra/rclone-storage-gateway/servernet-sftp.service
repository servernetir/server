[Unit]
Description=ServerNet managed backup SFTP gateway
After=network-online.target servernet-gateway.service

[Service]
Type=simple
User=servernet-gateway
Group=servernet-gateway
WorkingDirectory=/opt/servernet-gateway
EnvironmentFile=/etc/servernet-gateway.env
ExecStart=/usr/bin/rclone serve sftp --addr :2022 --auth-proxy /opt/servernet-gateway/auth_proxy.py --vfs-cache-mode writes --dir-cache-time 1m
Restart=always
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ReadWritePaths=/var/lib/servernet-gateway /var/cache/servernet-gateway

[Install]
WantedBy=multi-user.target
