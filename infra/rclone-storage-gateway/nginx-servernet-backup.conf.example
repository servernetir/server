# Replace example hostnames only after their A records point to the gateway.
# Obtain TLS certificates before enabling the 443 server blocks.

server {
    listen 443 ssl http2;
    server_name dav-backup.example.com;

    ssl_certificate /etc/letsencrypt/live/dav-backup.example.com/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/dav-backup.example.com/privkey.pem;

    client_max_body_size 0;
    proxy_request_buffering off;
    proxy_buffering off;
    proxy_read_timeout 3600s;
    proxy_send_timeout 3600s;

    location / {
        proxy_pass http://127.0.0.1:9081;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-Proto https;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    }
}

server {
    listen 443 ssl http2;
    server_name s3-backup.example.com;

    ssl_certificate /etc/letsencrypt/live/s3-backup.example.com/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/s3-backup.example.com/privkey.pem;

    client_max_body_size 0;
    proxy_request_buffering off;
    proxy_buffering off;
    proxy_read_timeout 3600s;
    proxy_send_timeout 3600s;

    location / {
        proxy_pass http://127.0.0.1:9082;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-Proto https;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    }
}

# Management API: publish only when the source address is the ServerNet panel.
server {
    listen 443 ssl http2;
    server_name gateway-backup.example.com;

    ssl_certificate /etc/letsencrypt/live/gateway-backup.example.com/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/gateway-backup.example.com/privkey.pem;

    allow 65.109.176.14;
    deny all;
    client_max_body_size 64k;

    location / {
        proxy_pass http://127.0.0.1:9080;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-Proto https;
    }
}
