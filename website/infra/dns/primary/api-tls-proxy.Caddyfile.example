# =============================================================================
# TLS برای APIِ PowerDNS — کلیدِ API هرگز روی HTTPِ ساده از اینترنت عبور نکند.
# مقصد: /etc/caddy/Caddyfile روی همان ماشینِ primary.
#
# • گواهیِ معتبرِ Let's Encrypt برای یک نامِ مدیریتی (رکوردِ A ابرِ خاکستری).
# • فقط IPِ واقعیِ خروجیِ برنامه (پیش از نصب با `curl -4 ifconfig.me` روی سرورِ برنامه
#   سنجیده شود؛ 65.109.176.14 را بی‌سنجش فرض نکنید) و فقط مسیرِ /api/v1/.
# • کلیدِ API همچنان لازم است؛ allowlist جایگزینِ احراز نیست.
# =============================================================================
DNS_API_HOSTNAME {
	@allowed {
		remote_ip APP_EGRESS_IP/32
		path /api/v1/*
	}
	handle @allowed {
		reverse_proxy 127.0.0.1:8081
	}
	handle {
		respond 404
	}
	# 🔴 عمداً بی access log: لاگِ JSONِ Caddy همهٔ هدرهای درخواست را می‌نویسد و به‌طورِ
	# پیش‌فرض فقط Cookie/Authorization را پنهان می‌کند — `X-API-Key` (کلیدِ کاملِ همهٔ zoneها)
	# هر دقیقه با dns:publish روی دیسک می‌نشست. ممیزی در خودِ برنامه است (cdn_events).
	# اگر لاگ لازم شد، فقط با حذفِ هدر، و پس از یک درخواستِ آزمایشی با
	# `grep -ci x-api-key /var/log/caddy/pdns-api.log` (باید ۰ باشد):
	#   log {
	#       output file /var/log/caddy/pdns-api.log
	#       format filter {
	#           wrap json
	#           fields {
	#               request>headers>X-Api-Key delete
	#           }
	#       }
	#   }
	# اگر پیش‌تر لاگی با کلید نوشته شده، کلیدِ API را عوض و لاگ را پاک کنید.
}
