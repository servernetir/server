APP_NAME=Laravel
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=laravel
# DB_USERNAME=root
# DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# Site contact info (header, footer, contact page, CTAs)
SITE_SUPPORT_PHONE="+1 (716) 666 0425"
SITE_SUPPORT_PHONE_LINK="+17166660425"
SITE_SUPPORT_EMAIL=support@servernet.cloud
SITE_SALES_EMAIL=sales@servernet.cloud
SITE_WHATSAPP="17166660425"

# AI site builder (GapGPT — OpenAI-compatible)
GAPGPT_API_KEY=
GAPGPT_BASE_URL=https://api.gapgpt.app/v1
GAPGPT_BUILDER_MODEL=claude-sonnet-5
GAPGPT_BUILDER_MODEL_PRO=claude-opus-4-8

# ─────────────────────────────────────────────────────────────────────────────
# موتورِ جذبِ مشتریِ خارجی (CRM)
# ─────────────────────────────────────────────────────────────────────────────
# 🔴 CRM_AUTOPILOT پیش‌فرض false است و این عمدی است: تا وقتی خودت ده پیش‌نویسِ
#    اول را در /admin/crm نخوانده‌ای، هیچ ایمیلی خودکار بیرون نمی‌رود.
CRM_AUTOPILOT=false

CRM_FROM_NAME="Ehsan Ebrahimi"
CRM_FROM_EMAIL=ceo@servernet.cloud

# سقفِ روزانه. گرم‌کردنِ دامنه از این هم پایین‌تر شروع می‌کند و پله‌پله بالا می‌آید.
CRM_CAP_EMAIL=30
CRM_WARMUP=true

# پنجرهٔ ارسال به وقتِ UTC. ۵ تا ۱۲ ≈ ۹ صبح تا ۴ بعدازظهرِ دوبی.
CRM_SEND_FROM=5
CRM_SEND_TO=12

# مدلِ نویسندهٔ پیام (از config/services.php ai_routing خوانده می‌شود)
AI_PROVIDER_OUTREACH=deepseek

# کشفِ سرنخ. بدونِ این کلید، سرنخ‌ها دستی از پنل وارد می‌شوند.
GOOGLE_PLACES_KEY=
CRM_DISCOVERY_PER_RUN=15

# صندوقِ ارسال — اگر خالی بماند همان MAIL_* استفاده می‌شود.
# جدا کردنش بهتر است: شکایتِ اسپمِ یک کلینیک نباید تحویلِ ایمیلِ فاکتور را خراب کند.
CRM_MAIL_HOST=
CRM_MAIL_PORT=
CRM_MAIL_USERNAME=
CRM_MAIL_PASSWORD=

# خواندنِ جواب‌ها. بدونِ این، فالوآپ برای کسی می‌رود که همین دیروز جواب داده.
CRM_IMAP_HOST=
CRM_IMAP_PORT=993
CRM_IMAP_USER=ceo@servernet.cloud
CRM_IMAP_PASS=
CRM_IMAP_FOLDER=INBOX
